<body lang=ZH-CN style='tab-interval:21.0pt;word-wrap:break-word;text-justify-trim:
punctuation'>

<div class=WordSection1 style='layout-grid:15.6pt'>

<p class=MsoNormal align=center style='text-align:center'><b><span
style='font-size:14.0pt;font-family:宋体'>毕业设计任务书</span></b></p>

<table class=MsoNormalTable border=0 cellspacing=0 cellpadding=0 width="100%"
 style='width:100.0%;border-collapse:collapse;mso-yfti-tbllook:1184;mso-padding-alt:
 0cm 0cm 0cm 0cm'>
 <tr style='mso-yfti-irow:0;mso-yfti-firstrow:yes;height:30.75pt'>
  <td width="15%" style='width:15.9%;border:solid windowtext 1.0pt;padding:
  0cm 5.4pt 0cm 5.4pt;height:30.75pt'>
  <p class=MsoNormal align=center style='text-align:center;line-height:16.0pt'><span
  style='font-family:宋体'>学部</span></p>
  </td>
  <td width="25%" style='width:25.62%;border:solid windowtext 1.0pt;border-left:
  none;padding:0cm 5.4pt 0cm 5.4pt;height:30.75pt'>
  <p class=wenzi align=center style='text-align:center;line-height:16.0pt'>信息学部</p>
  </td>
  <td width="12%" style='width:12.1%;border:solid windowtext 1.0pt;border-left:
  none;padding:0cm 5.4pt 0cm 5.4pt;height:30.75pt'>
  <p class=MsoNormal align=center style='text-align:center;line-height:16.0pt'><span
  style='font-family:宋体'>专业</span></p>
  </td>
  <td width="46%" colspan=3 style='width:46.38%;border:solid windowtext 1.0pt;
  border-left:none;padding:0cm 5.4pt 0cm 5.4pt;height:30.75pt'>
  <p class=wenzi align=center style='text-align:center;line-height:16.0pt'>软件工程<span
  lang=EN-US>(</span>阿里云校企合作班<span lang=EN-US>)</span></p>
  </td>
 </tr>
 <tr style='mso-yfti-irow:1;height:31.05pt'>
  <td width="15%" style='width:15.9%;border:solid windowtext 1.0pt;border-top:
  none;padding:0cm 5.4pt 0cm 5.4pt;height:31.05pt'>
  <p class=MsoNormal align=center style='text-align:center;line-height:16.0pt'><span
  style='font-family:宋体'>学生姓名</span></p>
  </td>
  <td width="25%" style='width:25.62%;border-top:none;border-left:none;
  border-bottom:solid windowtext 1.0pt;border-right:solid windowtext 1.0pt;
  padding:0cm 5.4pt 0cm 5.4pt;height:31.05pt'>
  <p class=wenzi align=center style='text-align:center;line-height:16.0pt'>马腾</p>
  </td>
  <td width="12%" style='width:12.1%;border-top:none;border-left:none;
  border-bottom:solid windowtext 1.0pt;border-right:solid windowtext 1.0pt;
  padding:0cm 5.4pt 0cm 5.4pt;height:31.05pt'>
  <p class=MsoNormal align=center style='text-align:center;line-height:16.0pt'><span
  style='font-family:宋体'>学号</span></p>
  </td>
  <td width="16%" style='width:16.12%;border-top:none;border-left:none;
  border-bottom:solid windowtext 1.0pt;border-right:solid windowtext 1.0pt;
  padding:0cm 5.4pt 0cm 5.4pt;height:31.05pt'>
  <p class=wenzi align=center style='text-align:center;line-height:16.0pt'><span
  lang=EN-US>20221204160</span></p>
  </td>
  <td width="12%" style='width:12.1%;border-top:none;border-left:none;
  border-bottom:solid windowtext 1.0pt;border-right:solid windowtext 1.0pt;
  padding:0cm 5.4pt 0cm 5.4pt;height:31.05pt'>
  <p class=MsoNormal align=center style='text-align:center;line-height:16.0pt'><span
  style='font-family:宋体'>班级</span></p>
  </td>
  <td width="18%" style='width:18.14%;border-top:none;border-left:none;
  border-bottom:solid windowtext 1.0pt;border-right:solid windowtext 1.0pt;
  padding:0cm 5.4pt 0cm 5.4pt;height:31.05pt'>
  <p class=wenzi align=center style='text-align:center;line-height:16.0pt'><span
  lang=EN-US>22</span>软本<span lang=EN-US>2</span></p>
  </td>
 </tr>
 <tr style='mso-yfti-irow:2;height:45.7pt'>
  <td width="15%" style='width:15.9%;border:solid windowtext 1.0pt;border-top:
  none;padding:0cm 5.4pt 0cm 5.4pt;height:45.7pt'>
  <p class=MsoNormal align=center style='text-align:center;line-height:16.0pt'><span
  style='font-family:宋体'>设计题目</span></p>
  </td>
  <td width="84%" colspan=5 style='width:84.1%;border-top:none;border-left:
  none;border-bottom:solid windowtext 1.0pt;border-right:solid windowtext 1.0pt;
  padding:0cm 5.4pt 0cm 5.4pt;height:45.7pt'>
  <p class=wenzi align=center style='text-align:center;line-height:16.0pt'>基于<span
  lang=EN-US>Django</span>的游戏推荐系统的设计与实现</p>
  </td>
 </tr>
 <tr style='mso-yfti-irow:3;height:84.05pt'>
  <td width="15%" style='width:15.9%;border:solid windowtext 1.0pt;border-top:
  none;padding:0cm 5.4pt 0cm 5.4pt;height:84.05pt'>
  <p class=MsoNormal align=center style='text-align:center;line-height:16.0pt'><span
  style='font-family:宋体'>设计要求</span></p>
  </td>
  <td width="84%" colspan=5 style='width:84.1%;border-top:none;border-left:
  none;border-bottom:solid windowtext 1.0pt;border-right:solid windowtext 1.0pt;
  padding:0cm 5.4pt 0cm 5.4pt;height:84.05pt'>
  <p class=MsoNormal align=left style='text-align:left'><span style='font-family:
  宋体;mso-bidi-font-family:宋体;color:windowtext'>本系统基于<span lang=EN-US> Django </span>开发，包含普通玩家、内容创作者、发行商、系统管理员四类用户：普通玩家可浏览搜索游戏、查看详情（评分<span
  lang=EN-US> / </span>攻略<span lang=EN-US> / </span>评测）、发布动态、互动评论点赞及参与话题；内容创作者能发布图文<span
  lang=EN-US> / </span>视频攻略；发行商可提交新游戏信息（名称<span lang=EN-US> / </span>类型<span
  lang=EN-US> / </span>标签）、更新版本，查看曝光量与评价关键词分析；管理员负责系统数据维护、规则制定及纠纷处理以保障社区生态。核心功能涵盖用户管理（注册登录、信息修改、查询热门游戏攻略）、数据采集处理（爬取热门<span
  lang=EN-US> / </span>热玩榜及游戏标签评分）、数据分析（按标签分析各类型游戏下载<span lang=EN-US> / </span>关注<span
  lang=EN-US> / </span>评价数、统计动态热度排名、加权筛选各类型<span lang=EN-US> Top10 </span>游戏并按最新<span
  lang=EN-US> / </span>最热推荐）及社区板块（发布攻略、评分互动、优质内容上首页）。<span lang=EN-US><o:p></o:p></span></span></p>
  </td>
 </tr>
 <tr style='mso-yfti-irow:4;height:52.9pt'>
  <td width="15%" style='width:15.9%;border:solid windowtext 1.0pt;border-top:
  none;padding:0cm 5.4pt 0cm 5.4pt;height:52.9pt'>
  <p class=MsoNormal align=center style='text-align:center;line-height:16.0pt'><span
  style='font-family:宋体'>重点解决的问题</span></p>
  </td>
  <td width="84%" colspan=5 style='width:84.1%;border-top:none;border-left:
  none;border-bottom:solid windowtext 1.0pt;border-right:solid windowtext 1.0pt;
  padding:0cm 5.4pt 0cm 5.4pt;height:52.9pt'>
  <p class=MsoNormal align=left style='text-align:left'><span style='font-family:
  宋体;mso-bidi-font-family:宋体;color:windowtext'>（<span lang=EN-US>1</span>）系统数据库设计，游戏推荐的算法设计。<span
  lang=EN-US><br>
  </span>（<span lang=EN-US>2</span>）数据获取与存储，游戏数据分析。<span lang=EN-US><o:p></o:p></span></span></p>
  </td>
 </tr>
 <tr style='mso-yfti-irow:5'>
  <td width="15%" style='width:15.9%;border:solid windowtext 1.0pt;border-top:
  none;padding:0cm 5.4pt 0cm 5.4pt'>
  <p class=MsoNormal align=center style='text-align:center;line-height:16.0pt'><span
  style='font-family:宋体'>资料查阅收集建议</span></p>
  </td>
  <td width="84%" colspan=5 style='width:84.1%;border-top:none;border-left:
  none;border-bottom:solid windowtext 1.0pt;border-right:solid windowtext 1.0pt;
  padding:0cm 5.4pt 0cm 5.4pt'>
  <p class=MsoNormal align=left style='text-align:left'><span class=wenzi1><span
  style='mso-bidi-font-family:宋体;color:windowtext'>建议查阅中英文文献资料不少于<span
  lang=EN-US>10</span>篇。其中可包括期刊、书籍、网络资源等多种形式，并包含至少<span lang=EN-US>3</span>篇外文技术文献。建议从知网、万方、百度文库等检索电子版，或从京东、当当、卓越等购买。推荐网络检索词为：<span
  lang=EN-US>Django</span>框架、人脸识别、考试系统等。推荐检索时段为近<span lang=EN-US>5</span>年。推荐参考文献样例如下：</span></span><span
  lang=EN-US style='font-family:宋体;mso-bidi-font-family:宋体;color:windowtext'><br>
  <span class=wenzi1>[1]</span></span><span class=wenzi1><span
  style='mso-bidi-font-family:宋体;color:windowtext'>黄永祥<span lang=EN-US>.Django3</span>　<span
  lang=EN-US>Web</span>应用开发实战<span lang=EN-US>[M].</span>清华大学出版社<span
  lang=EN-US>.</span>北京<span lang=EN-US>:2021</span>年<span lang=EN-US>07</span>月<span
  lang=EN-US>.</span></span></span><span lang=EN-US style='font-family:宋体;
  mso-bidi-font-family:宋体;color:windowtext'><br>
  <span class=wenzi1>[2]</span></span><span class=wenzi1><span
  style='mso-bidi-font-family:宋体;color:windowtext'>吕虹<span lang=EN-US>.</span>基于协同过滤算法的单机游戏推荐软件开发<span
  lang=EN-US>[J].</span>信息与电脑：理论版<span lang=EN-US>,</span>　<span lang=EN-US>2022(24):62-64.</span></span></span><span
  lang=EN-US style='font-family:宋体;mso-bidi-font-family:宋体;color:windowtext'><br>
  <span class=wenzi1>[3]</span></span><span class=wenzi1><span
  style='mso-bidi-font-family:宋体;color:windowtext'>田奥黔<span lang=EN-US>.Nintendo</span>　<span
  lang=EN-US>Switch</span>游戏推荐系统的研究与实现<span lang=EN-US>[D].</span>华东师范大学<span
  lang=EN-US>,2023.</span></span></span><span lang=EN-US style='font-size:12.0pt;
  font-family:宋体;mso-bidi-font-family:宋体;color:windowtext'><o:p></o:p></span></p>
  </td>
 </tr>
 <tr style='mso-yfti-irow:6;mso-yfti-lastrow:yes;height:146.05pt'>
  <td width="15%" style='width:15.9%;border:solid windowtext 1.0pt;border-top:
  none;padding:0cm 5.4pt 0cm 5.4pt;height:146.05pt'>
  <p class=MsoNormal align=center style='text-align:center;line-height:16.0pt'><span
  style='font-family:宋体'>进度计划</span></p>
  </td>
  <td width="84%" colspan=5 style='width:84.1%;border-top:none;border-left:
  none;border-bottom:solid windowtext 1.0pt;border-right:solid windowtext 1.0pt;
  padding:0cm 5.4pt 0cm 5.4pt;height:146.05pt'>
  <p class=wenzi style='line-height:16.0pt'><span lang=EN-US>2025</span>年<span
  lang=EN-US>7</span>月<span lang=EN-US>-8</span>月　通过文献调研，学习主要核心技术，确定课题研究内容。完成系统需求分析。依据需求，进行系统的数据库设计和软件概要设计，完成系统开发环境配置。<span
  lang=EN-US><br>
  2025</span>年<span lang=EN-US>9</span>月　撰写开题报告，参加开题答辩。根据答辩组意见修改完善系统设计。<span
  lang=EN-US><br>
  2025</span>年<span lang=EN-US>10</span>月<span lang=EN-US>-12</span>月　根据系统设计，实现各模块功能。进行模块测试，根据测试结果对系统进行调整和完善。撰写毕业设计报告初稿。<span
  lang=EN-US><br>
  2026</span>年<span lang=EN-US>1</span>月　完成中期检查表，参加中期答辩。根据中期检查意见优化系统设计与实现，进行系统整体测试。<span
  lang=EN-US><br>
  2026</span>年<span lang=EN-US>2</span>月<span lang=EN-US>-3</span>月　系统性能调优。修改完善毕业设计报告，准备答辩。</p>
  </td>
 </tr>
</table>

<p class=MsoNormal style='text-indent:24.0pt'><span lang=EN-US>&nbsp;</span></p>

<p class=MsoNormal style='text-indent:24.0pt'><span lang=EN-US>&nbsp;&nbsp;&nbsp;
</span><span style='font-family:宋体'>指导教师（签字）：</span><u><span lang=EN-US>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
</span></u><span lang=EN-US>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</span><span
style='font-family:宋体'>教研室主任（签字）：</span><u><span lang=EN-US>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
</span></u></p>

<p class=MsoNormal style='text-indent:134.2pt'><span style='font-family:宋体'>年</span><span
lang=EN-US>&nbsp;&nbsp;&nbsp; &nbsp;&nbsp;&nbsp; </span><span style='font-family:
宋体'>月</span><span lang=EN-US>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; &nbsp; </span><span
style='font-family:宋体'>日</span><span lang=EN-US>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</span><span style='font-family:宋体'>年<span
lang=EN-US>&nbsp; </span></span><span lang=EN-US>&nbsp;&nbsp; </span><span
style='font-family:宋体'>月</span><span lang=EN-US>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
&nbsp;&nbsp; </span><span style='font-family:宋体'>日</span></p>

</div>

</body>

